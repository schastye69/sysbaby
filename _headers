# Собран tools/publish.mjs. Правится не здесь, а там.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' 'sha256-KLgka53EhYPF+HaG9e5tC3nE/SnHlIUSNh7ion9cs9s=' 'sha256-vg6aV2t99APTVsX/8Hw8iQDfdrqyBnd2yCcVdAsgrgo=' 'sha256-byAreXeP/qcR6SDR4G0m9hucM3UiOaqkJ3xfEtOF4us=' 'sha256-fmaYzhvMIXvDwgang0z49OmEnSHTLHpcLh/2fLNn7aY=' 'sha256-e3noNbaqEgYeij8KwssefmR+Rk+cO5eB62SQ/XDxdag='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; worker-src 'self'; connect-src 'self' https://duckduckgo.com https://formsubmit.co; form-action 'self' https://duckduckgo.com https://formsubmit.co; frame-src 'self' https:; frame-ancestors 'self'; upgrade-insecure-requests

# Документ всегда свежий: в нём метка сборки, и он маленький.
/
  Cache-Control: no-store
/*.html
  Cache-Control: no-store

# ── РАБОТНИК — ЕДИНСТВЕННАЯ ЧАСТЬ БЕЗ НОМЕРА СБОРКИ (D-145) ──────────
# Его адрес всегда один и тот же: sw.js. Попади он под правило /*.js
# ниже — год «immutable», — и новый работник не пришёл бы НИКОГДА:
# система застыла бы на той сборке, которую человек открыл однажды.
# Правило стоит ВЫШЕ общего и названо поимённо.
/sw.js
  Cache-Control: no-store

# ── МАНИФЕСТ (D-287) тоже без номера сборки: телефон перечитывает его
# сам, и держать старый год значило бы держать старые значки и цель
# «Поделиться». Тип назван явно: не каждый хостинг знает .webmanifest.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/os/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Части несут номер сборки в адресе — их можно держать вечно.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
