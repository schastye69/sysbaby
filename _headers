# Собран tools/publish.mjs. Правится не здесь, а там.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Документ всегда свежий: в нём метка сборки, и он маленький.
/
  Cache-Control: no-store
/*.html
  Cache-Control: no-store

# Части несут номер сборки в адресе — их можно держать вечно.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# --- sys.baby/test · начало (ставит tools/deploy.mjs) ---
/test/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
